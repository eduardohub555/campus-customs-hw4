# Copy to .env in the directory ABOVE hw4/ (or set these in your environment),
# then fill in your own key. The real .env is git-ignored and must never be
# committed.

# Portkey key used to reach the model provider.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional — defaults to https://api.portkey.ai/v1 when unset.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
